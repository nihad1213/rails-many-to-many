<div class="container my-4" style="max-width: 750px;">
  <div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <span class="badge bg-secondary">Category details</span>
      <small class="text-muted">ID: <%= @category.id %></small>
    </div>
    <div class="card-body">
      <h1 class="card-title h3 mb-3"><%= @category.name %></h1>

      <h2 class="h5 mb-3">Articles (<%= @articles.size %>)</h2>
      <% if @articles.any? %>
        <ul class="list-group mb-4">
          <% @articles.each do |article| %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <%= link_to article.title, article_path(article), class: "text-decoration-none" %>
              <small class="text-muted">by <%= article.user.username if article.user %></small>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-secondary">No articles in this category yet.</p>
      <% end %>

      <div class="d-flex justify-content-between align-items-center border-top pt-3">
        <%= link_to "Back to categories", categories_path, class: "btn btn-outline-secondary" %>
        <div>
          <%= link_to "Edit", edit_category_path(@category), class: "btn btn-warning me-1" %>
          <%= link_to "Delete",
                      category_path(@category),
                      class: "btn btn-danger",
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "Are you sure you want to delete this category?"
                      } %>
        </div>
      </div>
    </div>
  </div>
</div>