<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Categories</h1>
    <%= link_to "Create new category", new_category_path, class: "btn btn-primary" %>
  </div>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover table-striped align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Articles</th>
            <th scope="col" class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @categories.each do |category| %>
            <tr>
              <td class="fw-semibold"><%= category.name %></td>
              <td class="text-secondary"><%= category.articles.size %></td>
              <td class="text-end pe-3">
                <div class="btn-group btn-group-sm" role="group">
                  <%= link_to "Show", category_path(category), class: "btn btn-outline-primary" %>
                  <%= link_to "Edit", edit_category_path(category), class: "btn btn-outline-secondary" %>
                  <%= link_to "Delete",
                              category_path(category),
                              class: "btn btn-outline-danger",
                              data: {
                                turbo_method: :delete,
                                turbo_confirm: "Are you sure you want to delete this category?"
                              } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if @pagy.pages > 1 %>
    <div class="d-flex justify-content-center mt-4">
      <%== @pagy.series_nav(:bootstrap) %>
    </div>
  <% end %>
</div>