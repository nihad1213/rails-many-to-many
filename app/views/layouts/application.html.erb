<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rails Blog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Rails Blog", root_path, class: "navbar-brand fw-bold" %>
        <div class="d-flex align-items-center gap-2">
          <% if logged_in? %>
            <span class="text-light me-2">
              Signed in as <strong><%= current_user.username %></strong>
            </span>
            <%= link_to "New Article", new_article_path, class: "btn btn-outline-light" %>
            <%= button_to "Logout", logout_path, method: :delete, class: "btn btn-danger" %>
          <% else %>
            <%= link_to "Login", login_path, class: "btn btn-outline-light" %>
            <%= link_to "Sign Up", signup_path, class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    </header>

    <div class="container">
      <% flash.each do |name, msg| %>
        <div class="alert alert-<%= name == 'notice' ? 'success' : 'danger' %> alert-dismissible fade show" role="alert">
          <%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>