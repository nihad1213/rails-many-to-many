<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Articles Listing Page</h1>
    <%= link_to "Create new article", new_article_path, class: "btn btn-primary" %>
  </div>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover table-striped align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th scope="col">Title</th>
            <th scope="col">Description</th>
            <th scope="col">Author</th>
            <th scope="col" class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @articles.each do |article| %>
            <tr>
              <td class="fw-semibold"><%= article.title %></td>
              <td class="text-secondary"><%= article.description %></td>
              <td class="test-text-secondary"><%= article.user.username if article.user%></td>
              <td class="text-end pe-3">
                <div class="btn-group btn-group-sm" role="group">
                  <%= link_to "Show", article_path(article), class: "btn btn-outline-primary" %>
                  <%= link_to "Edit", edit_article_path(article), class: "btn btn-outline-secondary" %>
                  <%= link_to "Delete",
                              article_path(article),
                              class: "btn btn-outline-danger",
                              data: {
                                turbo_method: :delete,
                                turbo_confirm: "Are you sure you want to delete this article?"
                              } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
    <% if @pagy.pages > 1 %>
    <div class="d-flex justify-content-center mt-4">
      <%== @pagy.series_nav(:bootstrap) %>
    </div>
  <% end %>
</div>